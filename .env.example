# Copy to .env (never commit it), then run with `uv run --env-file .env ...`
# or `docker run --env-file .env ...`.

# The default model key: an OpenAI API key. This is usually the only setting you need.
# A Claude (Anthropic) key can be entered in the SOP console instead, for that browser only.
# Without any key, replies come from a stand-in.
AI_API_KEY=

# Optional; leave empty for OpenAI with gpt-6-luna. To make Claude the default, set
# "anthropic" and put an Anthropic key in AI_API_KEY.
AI_PROVIDER=
AI_MODEL=
# none | low | medium | high; leave empty for models without reasoning.
AI_REASONING_EFFORT=low
# Optional OpenAI-compatible endpoint.
AI_BASE_URL=

# Email summaries are always simulated.
EMAIL_MODE=mock

# The fixture data is self-consistent between 2026-03-01 and 2026-03-18.
DEMO_AS_OF_DATE=2026-03-10

# Simulated policyholder consent for representative callers: default | timeout
CONSENT_SCENARIO=default

# Placeholder member portal; each claim's upload link is <portal>/claims/<case id>/upload.
DEMO_PORTAL_URL=https://portal.example.com

# Set to true when the app is served over HTTPS.
COOKIE_SECURE=false

